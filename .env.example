APP_NAME=Kisan Dost AI
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Ollama is optional; app starts without it.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=30

# Open-Meteo endpoints
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
HTTP_TIMEOUT_SECONDS=8

DATABASE_PATH=./data/kisan_dost.sqlite3
DEFAULT_LANGUAGE=en
# Indic-Transcribe-Core configuration
INDIC_ASR_MODEL=bodhan-ai/indic-transcribe-core

# Run on CPU
INDIC_ASR_DEVICE=cpu

# Maximum uploaded audio size: 20 MB
MAX_AUDIO_BYTES=20971520
